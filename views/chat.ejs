<% layout("./layouts/boilerplate") -%>
<body>
    <div class="main flex w-full h-screen overflow-hidden relative">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-black/50 z-100 opacity-100 flex items-center justify-center film hide">
            <div class="code-box bg-white w-90 h-120 rounded-md relative flex flex-col p-10">
                <div class="close absolute top-2 right-2"><i class="fa-solid fa-xmark"></i></div>
                <div class="text-2xl text-blue-500">Get Your Share Code</div>
                <div class="text-blue-400 mt-4">Your permanent share code</div>
                <div class="text-sm flex w-[80%] bg-slate-200 justify-between p-2 rounded-md relative">
                    <span class="permanent-code inline-block" data-code="<%= encrypt(user1._id) %>"><%= encrypt(user1._id) %></span>
                    <span class="permanent-code-copy w-6 h-6 flex items-center justify-center rounded-md"><i class="fa-regular fa-copy"></i></span>
                    <div class="copied bg-white text-slate-700 shadow-md w-14 h-8 rounded-md flex items-center justify-center absolute -right-14 -top-6 hide">Copied</div>
                </div>
                <div class="text-blue-400 mt-4">Don't want to share permanent code?</div>
                <div class="text-sm text-justify w-[90%]">Try user specific codes! Enter the username of friend to which you want to share your code and get a code by which only your friend can add you!</div>
                <div class="userBox w-full flex mt-4">
                    <input type="text" placeholder="Enter Username" class="user-input inline-block w-[60%] px-4 outline-1 rounded-sm">
                    <button class="bg-blue-600 text-white h-8 rounded-sm inline-block w-20 ml-2 self-center gen-code">Get Code</button>
                </div>
                <span class="text-red-500 hide text-sm empty-user">please enter a username</span>
                <span class="text-red-500 hide text-sm not-user"></span>
                <div class="text-blue-400 mt-4 temp-mes hide">Your user specific share code</div>
                <div class="text-sm flex w-full bg-slate-200 justify-between p-2 rounded-md relative temp-box hide">
                    <span class="temporary-code inline-block"></span>
                    <span class="temporary-code-copy w-6 h-6 flex items-center justify-center rounded-md"><i class="fa-regular fa-copy"></i></span>
                    <div class="temp-copied bg-white text-slate-700 shadow-md w-14 h-8 rounded-md flex items-center justify-center absolute -right-14 -top-6 hide">Copied</div>
                </div>
            </div>
        </div>
        <div class="rooms w-1/3 h-full overflow-y-auto text-blue-700 flex flex-col">
            <div class="search w-full flex justify-around items-center relative">
                <input type="text" placeholder="Search" class="search-input inline-block w-[70%] h-12 bg-slate-300 my-4 p-4 rounded-lg focus:outline-none focus:ring-0" id="search">
                <div class="dots relative flex flex-col items-center justify-center w-8 h-8 bg-slate-200 text-slate-700 rounded-full cursor-pointer selection:text-slate-700">
                    <span class="rotate-90 text-2xl ml-3">...</span>
                    <div class="absolute w-40 top-8 right-0 bg-white z-100 dropdown hide rounded-sm shadow-md">
                        <div class="add-friend w-full h-10 text-md hover:bg-slate-100 p-1">
                            <i class="fa-solid fa-user-plus text-blue-600 text-sm"></i> Add Friend
                        </div>
                        <div class="get-code w-full h-10 text-md hover:bg-slate-100 p-1">
                            <i class="fa-solid fa-share-nodes text-blue-600 text-sm"></i> Get Share Code
                        </div>
                        <div class="logout w-full h-10 text-md text-red-500 border-t border-t-amber-100 hover:bg-slate-100 p-1">
                            <i class="fa-solid fa-right-from-bracket text-sm"></i> Logout
                        </div>
                    </div>
                </div> 
            </div>
            <form action="/" method="post" class="hide room-form w-[90%] h-64 flex flex-col rounded-md shadow-lg mx-auto my-4 items-center justify-center">
                <h3 class="self-start text-black ml-4">Add Friend</h3>
                <input type="text" placeholder="Username" name="username" class="w-[80%] p-2 rounded-md m-4 outline outline-2 outline-black" required>
                <input type="text" placeholder="Enter friend share code" name="code" class="w-[80%] p-2 rounded-md m-4 outline outline-2 outline-black" required>
                <button class="w-[80%] bg-gradient-to-r from-blue-400 to-blue-700 text-white rounded-md h-[36px] m-4">Start Chat</button>
            </form> 
            <div class="room-container overflow-y-auto w-full">
                <% for(let room of rooms){ %>
                    <div class="room flex items-center w-[90%] h-16 border-b border-b-blue-300 bg-slate-200 hover:bg-slate-300 mx-auto my-2 rounded-2xl" data-id="<%= room._id %>">
                        <% if(room.roomType == "private" && user.userName == room.members[0].userName){ %>
                            <div class="profile w-8 h-8 rounded-full bg-blue-600 ml-4 mr-4 text-2xl flex items-center justify-center text-white p-0"><%= room.members[1].userName[0].toUpperCase() %></div>
                            <div class="name-message w-[70%]" data-name="<%= room.members[1].userName %>" data-message="<%= room.lastMessage %>" data-time="<%= displayTime(room.lastTime) %>">
                                <%= room.members[1].userName %>
                                <br>
                                <div class="mes-box flex justify-between w-full" data-rid="<%= room._id %>">
                                    <span class="mes-con text-sm text-black">
                                        <% if(room.lastMessage && room.lastMessage.length >= 18){ %>
                                            <%= room.lastMessage.slice(0,19) + "..." %>
                                        <% } %>
                                        <% if(room.lastMessage && room.lastMessage.length < 18){ %>
                                            <%= room.lastMessage %>
                                        <% } %>
                                    </span>
                                    <span class="mes-time text-sm text-black">
                                        <% if(room.lastTime){ %>
                                            <% if(compareDate(room.lastTime, serverCurrentTime)){ %>
                                                <%= displayTime(room.lastTime) %>
                                            <% } %>
                                            <% if(!compareDate(room.lastTime, serverCurrentTime)){ %>
                                                <%= displayDate(room.lastTime) %>
                                            <% } %>
                                        <% } %>
                                    </span>
                                </div>
                            </div>
                        <% } %>
                        <% if(room.roomType == "private" && user.userName == room.members[1].userName){ %>
                            <div class="profile w-8 h-8 rounded-full bg-blue-600 ml-4 mr-4 text-2xl flex items-center justify-center text-white p-0"><%= room.members[0].userName[0].toUpperCase() %></div>
                            <div class="name-message w-[70%]" data-name="<%= room.members[0].userName %>" data-message="<%= room.lastMessage %>" data-time="<%= displayTime(room.lastTime) %>">
                                <%= room.members[0].userName %>
                                <br>
                                <div class="mes-box flex justify-between w-full" data-rid="<%= room._id %>">
                                    <span class="mes-con text-sm text-black">
                                        <% if(room.lastMessage && room.lastMessage.length >= 18){ %>
                                            <%= room.lastMessage.slice(0,19) + "..." %>
                                        <% } %>
                                        <% if(room.lastMessage && room.lastMessage.length < 18){ %>
                                            <%= room.lastMessage %>
                                        <% } %>
                                    </span>
                                    <span class="mes-time text-sm text-black">
                                        <% if(room.lastTime){ %>
                                            <% if(compareDate(room.lastTime, serverCurrentTime)){ %>
                                                <%= displayTime(room.lastTime) %>
                                            <% } %>
                                            <% if(!compareDate(room.lastTime, serverCurrentTime)){ %>
                                                <%= displayDate(room.lastTime) %>
                                            <% } %>
                                        <% } %>
                                    </span>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
        <div class="chats w-2/3 h-full overflow-y-auto bg-slate-100">
            <div class="header flex items-center bg-white w-full h-[10vh] border-l-slate-700 border-b-slate-300">
                <div class="profile w-12 h-12 rounded-full bg-blue-600 ml-4 mr-4 text-4xl flex items-center justify-center text-white p-0"><%= user2.userName[0].toUpperCase() %></div>
                <div>
                    <h3>
                        <%= user2.userName %>
                    </h3>
                    <div class="typing text-blue-500 h-4 text-sm">
                        <% if(user2.status && user2.status == "Online"){ %>
                            <%= "Online" %>
                        <% } %>
                        <% if(user2.status && user2.status == "Offline"){ %>
                            <% if(user2.lastActive){ %>
                                <%= `last seen at ${displayTime(user2.lastActive)} ${displayDate(user2.lastActive)}` %>
                            <% } %>
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="message flex flex-col w-full h-[75vh] overflow-y-auto">
                <% let date; %>
                <% if(messages && messages.length > 0){ %>
                    <% date = messages[0].createdAt %>
                <% } %>
                <% let i = 0 %>
                <% for(let message of messages){ %>
                    <% if(!compareDate(message.createdAt, date) || i == 0){ %>
                        <div class="date self-center bg-slate-200 text-slate-700 rounded-md w-16 h-8 text-sm p-4 flex items-center justify-center my-4" data-date="<%= displayDate(message.createdAt) %>">
                            <% if(compareDate(serverCurrentTime, message.createdAt)){ %>
                                <%= "today" %>
                            <% } %>
                            <% if(!compareDate(serverCurrentTime, message.createdAt)){ %>
                                <%= displayDate(message.createdAt) %>
                            <% } %>
                        </div>
                        <% date = message.createdAt %>
                    <% } %>
                    <% if(message.sender.toString() == user1._id.toString()){ %>
                        <div class="msg-token flex flex-col self-end bg-blue-500 text-white w-1/3 p-4 rounded-tl-2xl rounded-bl-2xl rounded-br-2xl m-4">
                            <%= message.content %>
                            <span class="text-sm self-end"><%= displayTime(message.createdAt) %></span>
                        </div>
                    <% } %>
                    <% if(message.sender.toString() != user1._id.toString()){ %>
                        <div class="msg-token flex flex-col self-start bg-slate-300 w-1/3 p-4 rounded-tr-2xl rounded-bl-2xl rounded-br-2xl m-4">
                            <%= message.content %>
                            <span class="text-sm self-end"><%= displayTime(message.createdAt) %></span>
                        </div>
                    <% } %>
                    <% i++ %>
                <% } %>
            </div>
            <div class="flex justify-center chat-form h-[15vh]">
                <input type="text" placeholder="Enter message" name="message" id="message" class="bg-white w-[80%] h-12 m-4 rounded-lg p-6 focus:outline-none focus:ring-0" required>
                <button class="bg-blue-600 text-white h-12 w-16 m-4 rounded-md chat-btn">Send</button>
            </div>
        </div>
    </div>
    
    <script>
        // document.addEventListener("DOMContentLoaded", () => {
            const room = "<%= roomId %>";
            const sender = "<%= user1._id %>";
            const receiver = "<%= user2._id%>";
            let hasMessage = "<%= hasMessage %>"
            let lastMessageTime;
            lastMessageTime = <% if (messages && messages.length > 0) { %> "<%= messages[messages.length-1].createdAt %>" <% } else { %> null <% } %>;
            socket.on("connect", () => {
                socket.emit("join_personal_room", { id: sender });
            });

            socket.emit("join_room", {sender, room});
            const msgBox = document.querySelector(".message");
            const form = document.querySelector(".chat-btn");
            const input = document.querySelector("#message");
            const msBox = document.querySelectorAll(".mes-box");
            const date = document.querySelectorAll(".date");

            const displayDate = function(time){
                const dateObj = new Date(time);
                const options = {
                    timeZone: 'Asia/Kolkata',
                    day: '2-digit',
                    month: '2-digit',
                    year: '2-digit' 
                };

                const formatter = new Intl.DateTimeFormat('en-GB', options);
                const formattedDate = formatter.format(dateObj); 

                return formattedDate; 
            }

            const compareDate = function(time1, time2){;
                let date1 = displayDate(time1);
                let date2 = displayDate(time2);
                return date1 === date2;
            }

            const displayTime = function(dateInput) {
                let date = new Date(dateInput);

                if (isNaN(date.getTime())) {
                    date = new Date();
                }

                return date.toLocaleTimeString('en-IN', {
                    timeZone: 'Asia/Kolkata',
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: true 
                });
            }

            function scrollToBottom() {
                const chatContainer = document.querySelector(".message"); 
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }

            window.onload = () => {
                scrollToBottom();
            }

            input.addEventListener("input", () => {
                socket.emit("typing", {room});
            });

            form.addEventListener("click", () => {
                if(input.value.trim()){
                    socket.emit("message", {text: input.value, room, sender, receiver});
                    scrollToBottom();
                }
                input.value = "";
            });

            socket.on("message", ({text, sender: sender1, time}) => {
                const clientCurrentTime = new Date().toISOString();
                if(!lastMessageTime || !compareDate(clientCurrentTime, lastMessageTime)){
                    const dDiv = document.createElement("div");
                    dDiv.classList.add(
                        "date", 
                        "self-center", 
                        "bg-slate-200", 
                        "text-slate-700", 
                        "rounded-md", 
                        "w-16", 
                        "h-8", 
                        "text-sm", 
                        "p-4", 
                        "flex", 
                        "items-center", 
                        "justify-center", 
                        "my-4"
                    );
                    dDiv.innerText = "today";
                    dDiv.setAttribute("data-date", `${displayDate(clientCurrentTime)}`);
                    if(date && date.length > 0) date[date.length-1].innerText = date[date.length-1].getAttribute("data-date")
                    msgBox.append(dDiv);
                }
                let msg = document.createElement("div");
                msg.innerText = `${text}`;
                let t = document.createElement("span");
                t.innerText = `${time}`;
                t.classList.add("text-sm", "self-end");
                msg.append(t);
                if(sender1.toString() != sender.toString()){
                    msg.classList.add("flex", "flex-col", "self-start", "bg-slate-300", "w-1/3", "p-4", "rounded-tr-2xl", "rounded-bl-2xl", "rounded-br-2xl", "m-4", "msg-token");
                } else {
                    msg.classList.add("flex", "flex-col", "self-end", "bg-blue-500", "w-1/3", "p-4", "rounded-tl-2xl", "rounded-bl-2xl", "rounded-br-2xl", "m-4", "text-white", "msg-token");
                }
                msgBox.append(msg);
                scrollToBottom();
                lastMessageTime = clientCurrentTime;
            });

            let typingTimeout;
            let prevMes = document.querySelector(".typing").innerText;
            socket.on("typing", () => {
                let typing = document.querySelector(".typing");
                console.log(prevMes);
                typing.innerText = "typing ...";
                clearTimeout(typingTimeout);
                typingTimeout = setTimeout(() => {
                    typing.innerText = prevMes;
                }, 1000);
            });

            socket.on("message_received", ({room, time, text}) => {
                console.log("message_received");
                for(let mes of msBox){
                    if(mes.getAttribute("data-rid").toString() == room.toString()){
                        let ms = text;
                        if(text.length >= 18){
                            ms = text.slice(0, 19) + "...";
                        }
                        mes.children[0].innerText = ms;
                        mes.children[1].innerText = time;
                    }
                }
            });

            let friend = document.querySelector(".add-friend");
            let addFriend = document.querySelector(".room-form");

            friend.addEventListener("click", () => {
                addFriend.classList.toggle("hide");
            });

            let rooms = document.querySelectorAll(".room");
            for(let room of rooms){
                room.addEventListener("click", () => {
                    window.location.href = `/chats/${room.getAttribute("data-id")}`;
                });
            }

            socket.on("going_offline", ({serverCurrentTime, room, id}) => {
                console.log("going_offline", room);
                if(id != sender){
                    let typing = document.querySelector(".typing");
                    typing.innerText = "last seen at " + displayTime(serverCurrentTime) + " " + displayDate(serverCurrentTime);
                    prevMes = "last seen at " + displayTime(serverCurrentTime) + " " + displayDate(serverCurrentTime);
                }
            });

            socket.on("user_status_changed", ({id, status}) => {
                if(receiver == id){ // receiver is online
                    let typing = document.querySelector(".typing");
                    typing.innerText = status;
                    prevMes = status;
                }
            });

            let dots = document.querySelector(".dots");
            let dropDown = document.querySelector(".dropdown");
            dots.addEventListener("click", () => {
                dropDown.classList.toggle("hide");
            });
            let logout = document.querySelector(".logout");
            logout.addEventListener("click", () => {
                window.location.href = "/logout";
            });
        // });
    </script>
    <script src="/scripts/search.js"></script>
    <script src="/scripts/secretCode.js"></script>
</body>